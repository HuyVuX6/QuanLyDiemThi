<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== WIZARD IMPORT CÂU HỎI TỪ EXCEL ==================== -->
    <record id="view_exam_question_import_wizard_form" model="ir.ui.view">
        <field name="name">exam.question.import.wizard.form</field>
        <field name="model">exam.question.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Ngân Hàng Câu Hỏi Từ Excel">
                <sheet>
                    <field name="state" invisible="1"/>
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-3" role="status">
                            <div>
                                <h6 class="fw-bold mb-1 text-primary"><i class="fa fa-info-circle me-1" title="Hướng dẫn"/> Bộ Nguyên Tắc Import Câu Hỏi Toán Lớp 3:</h6>
                                <ul class="mb-0 ps-3 small">
                                    <li>Định dạng tệp: <strong>.xlsx</strong> hoặc <strong>.xls</strong>. Dòng 1 là tiêu đề cột, dữ liệu tính từ dòng 2.</li>
                                    <li>Các cột bắt buộc (*): <strong>Mã Câu Hỏi, Nội Dung, Chủ Đề, Đáp Án Chuẩn</strong>.</li>
                                    <li>Chủ đề hợp lệ: <em>Phép Cộng, Phép Trừ, Phép Nhân, Phép Chia, Hình Học, Toán Lời Văn</em>.</li>
                                    <li>Dạng câu hỏi: <em>Điền số (mặc định), Trắc nghiệm (A, B, C, D), Tự luận ngắn</em>.</li>
                                    <li>Độ khó: <em>Dễ, Trung Bình, Khó</em>. Điểm mặc định: <em>1.0</em>.</li>
                                </ul>
                            </div>
                            <div class="ms-3">
                                <a href="/educational_system/download_question_template" class="btn btn-outline-primary btn-sm text-nowrap fw-bold" role="button"><i class="fa fa-download me-1" title="Tải về"/> 📄 Tải File Excel Mẫu</a>
                            </div>
                        </div>

                        <group>
                            <group string="Tệp Dữ Liệu Excel">
                                <field name="excel_file" filename="filename" widget="binary"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <group string="Quy Tắc Xử Lý">
                                <field name="duplicate_behavior"/>
                                <field name="default_points"/>
                            </group>
                        </group>
                    </div>

                    <div invisible="state != 'done'">
                        <field name="result_html" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import_excel" 
                            string="🚀 Bắt Đầu Import Dữ Liệu" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'draft'"/>
                    <button name="action_reset" 
                            string="🔄 Import Tệp Khác" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="state != 'done'"/>
                    <button name="action_view_questions" 
                            string="📂 Xem Danh Sách Câu Hỏi" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'done'"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_exam_question_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Câu Hỏi Từ Excel</field>
        <field name="res_model">exam.question.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_exam_question"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- ==================== 1. NGÂN HÀNG CÂU HỎI (exam.question) ==================== -->
    <record id="view_exam_question_list" model="ir.ui.view">
        <field name="name">exam.question.list</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <list string="Ngân Hàng Câu Hỏi Toán 3">
                <header>
                    <button name="%(action_exam_question_import_wizard)d" 
                            string="📥 Import Excel Câu Hỏi" 
                            type="action" 
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="code"/>
                <field name="content"/>
                <field name="question_type"/>
                <field name="topic"/>
                <field name="difficulty" widget="badge" decoration-success="difficulty == 'Easy'" decoration-warning="difficulty == 'Medium'" decoration-danger="difficulty == 'Hard'"/>
                <field name="correct_answer"/>
                <field name="points"/>
            </list>
        </field>
    </record>

    <record id="view_exam_question_form" model="ir.ui.view">
        <field name="name">exam.question.form</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <form string="Câu Hỏi Toán Lớp 3">
                <header>
                    <button name="%(action_exam_question_import_wizard)d" 
                            string="📥 Import Excel Câu Hỏi" 
                            type="action" 
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Mã Câu Hỏi"/>
                        <h1><field name="code" placeholder="CH-T3-001"/></h1>
                    </div>
                    <group>
                        <group string="Phân Loại &amp; Thang Điểm">
                            <field name="topic"/>
                            <field name="difficulty"/>
                            <field name="question_type"/>
                            <field name="points"/>
                        </group>
                        <group string="Cấu Hình Đáp Án">
                            <field name="correct_answer" placeholder="Ví dụ: 15 hoặc A"/>
                            <field name="acceptable_answers" placeholder="Ví dụ: 15 quả|15 quả táo (ngăn cách bởi dấu | hoặc ;)"/>
                            <field name="tolerance" invisible="question_type != 'numeric'"/>
                        </group>
                    </group>
                    <group string="Nội Dung Câu Hỏi">
                        <field name="content" nolabel="1" placeholder="Nhập đề bài câu hỏi tại đây..."/>
                    </group>
                    <group string="Hướng Dẫn Giải / Đáp Án Chi Tiết">
                        <field name="explanation" nolabel="1" placeholder="Nhập lời giải thích mẫu hoặc phương pháp giải..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_question_search" model="ir.ui.view">
        <field name="name">exam.question.search</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Câu Hỏi">
                <field name="code"/>
                <field name="content"/>
                <field name="correct_answer"/>
                <filter string="Phép Cộng" name="filter_add" domain="[('topic', '=', 'Addition')]"/>
                <filter string="Phép Trừ" name="filter_sub" domain="[('topic', '=', 'Subtraction')]"/>
                <filter string="Phép Nhân" name="filter_mul" domain="[('topic', '=', 'Multiplication')]"/>
                <filter string="Phép Chia" name="filter_div" domain="[('topic', '=', 'Division')]"/>
                <filter string="Hình Học" name="filter_geo" domain="[('topic', '=', 'Geometry')]"/>
                <filter string="Toán Lời Văn" name="filter_word" domain="[('topic', '=', 'WordProblem')]"/>
                <separator/>
                <filter string="Mức Độ Dễ" name="filter_easy" domain="[('difficulty', '=', 'Easy')]"/>
                <filter string="Mức Độ Khó" name="filter_hard" domain="[('difficulty', '=', 'Hard')]"/>
                <group>
                    <filter string="Chủ Đề" name="group_topic" domain="[]" context="{'group_by': 'topic'}"/>
                    <filter string="Độ Khó" name="group_difficulty" domain="[]" context="{'group_by': 'difficulty'}"/>
                    <filter string="Dạng Câu Hỏi" name="group_qtype" domain="[]" context="{'group_by': 'question_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_exam_question" model="ir.actions.act_window">
        <field name="name">Ngân Hàng Câu Hỏi</field>
        <field name="res_model">exam.question</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_exam_question_search"/>
    </record>

    <!-- ==================== 2. ĐỀ THI (exam.exam) ==================== -->
    <record id="view_exam_exam_list" model="ir.ui.view">
        <field name="name">exam.exam.list</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Đề Thi">
                <field name="code"/>
                <field name="name"/>
                <field name="exam_type"/>
                <field name="topic"/>
                <field name="total_questions"/>
                <field name="total_score"/>
                <field name="time_limit_minutes"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'draft'" decoration-muted="status == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_exam_exam_form" model="ir.ui.view">
        <field name="name">exam.exam.form</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <form string="Đề Thi">
                <header>
                    <button name="action_open_assign_wizard" string="Gán Đề Cho Lớp / Học Sinh" type="object" class="oe_highlight" invisible="status != 'active'"/>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên Đề Thi"/>
                        <h1><field name="name" placeholder="Ví dụ: Đề Kiểm Tra Giữa Kỳ I - Toán 3"/></h1>
                    </div>
                    <group>
                        <group string="Cấu Hình Đề Thi">
                            <field name="code" placeholder="DE-T3-GK1"/>
                            <field name="exam_type"/>
                            <field name="topic"/>
                            <field name="auto_analyze"/>
                        </group>
                        <group string="Thang Điểm &amp; Thời Gian">
                            <field name="total_score"/>
                            <field name="time_limit_minutes"/>
                            <field name="total_questions"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ngân Hàng Câu Hỏi Trong Đề">
                            <field name="question_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="content"/>
                                    <field name="topic"/>
                                    <field name="difficulty"/>
                                    <field name="points"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lịch Sử Làm Bài Của Học Sinh">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="student_id"/>
                                    <field name="class_id"/>
                                    <field name="total_score"/>
                                    <field name="percentage" widget="progressbar"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_exam_search" model="ir.ui.view">
        <field name="name">exam.exam.search</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Đề Thi">
                <field name="name"/>
                <field name="code"/>
                <field name="topic"/>
                <filter string="Đang Hoạt Động" name="filter_active" domain="[('status', '=', 'active')]"/>
                <group>
                    <filter string="Loại Đề Thi" name="group_type" domain="[]" context="{'group_by': 'exam_type'}"/>
                    <filter string="Trạng Thái" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_exam_exam" model="ir.actions.act_window">
        <field name="name">Đề Thi Toán 3</field>
        <field name="res_model">exam.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_exam_exam_search"/>
    </record>

    <!-- ==================== 2.5. ĐỢT KIỂM TRA (exam.batch) ==================== -->
    <record id="view_exam_batch_list" model="ir.ui.view">
        <field name="name">exam.batch.list</field>
        <field name="model">exam.batch</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Đợt Kiểm Tra">
                <field name="code"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="grade_id"/>
                <field name="batch_type" widget="badge"/>
                <field name="exam_id"/>
                <field name="start_datetime" string="Bắt Đầu"/>
                <field name="end_datetime" string="Hạn Chót / Kết Thúc"/>
                <field name="is_expired" widget="boolean_toggle" string="Hết Hạn"/>
                <field name="delivery_mode" widget="badge" decoration-info="delivery_mode == 'offline'"/>
                <field name="total_students" string="Sĩ Số Thi"/>
                <field name="passed_count" string="Số Đạt" decoration-success="passed_count &gt; 0"/>
                <field name="failed_count" string="Số Rớt" decoration-danger="failed_count &gt; 0"/>
                <field name="pass_rate" widget="progressbar"/>
                <field name="average_score" string="Điểm TB"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'in_progress'" decoration-success="status == 'completed'" decoration-danger="status == 'locked'"/>
            </list>
        </field>
    </record>

    <record id="view_exam_batch_form" model="ir.ui.view">
        <field name="name">exam.batch.form</field>
        <field name="model">exam.batch</field>
        <field name="arch" type="xml">
            <form string="Đợt Kiểm Tra Của Lớp">
                <header>
                    <button name="action_populate_students" 
                            string="👥 Lập Danh Sách Học Sinh" 
                            type="object" 
                            class="btn-primary" 
                            invisible="status in ('completed', 'locked')"/>
                    <button name="action_open_import_wizard" 
                            string="📥 Import Bài Làm Excel &amp; Chấm Điểm" 
                            type="object" 
                            class="btn-success" 
                            invisible="status in ('completed', 'locked')"/>
                    <button name="action_lock_batch" 
                            string="🔒 Khóa Đợt Thi" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="status == 'locked'"/>
                    <button name="action_unlock_batch" 
                            string="🔓 Mở Khóa Đợt Thi" 
                            type="object" 
                            class="btn-outline-warning" 
                            invisible="status != 'locked'" 
                            groups="educational_system.group_school_manager,educational_system.group_school_teacher"/>
                    <button name="action_create_retest_batch" 
                            string="🔁 Tạo Đợt Thi Lại Cho HS Rớt" 
                            type="object" 
                            class="btn-warning" 
                            invisible="failed_count == 0 or status not in ('completed', 'locked')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_progress,completed,locked"/>
                </header>
                <sheet>
                    <!-- Cảnh báo khi đợt thi đã bị khóa / hết hạn -->
                    <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-3 rounded-3" role="status" invisible="status != 'locked'">
                        <div>
                            <i class="fa fa-lock fa-2x me-2 align-middle text-danger"/>
                            <span class="fs-5 align-middle fw-semibold">Đợt kiểm tra này đã kết thúc vào lúc <strong><field name="end_datetime" readonly="1"/></strong> và đã bị khóa. Không thể nhập thêm bài làm.</span>
                        </div>
                    </div>

                    <!-- Banner hướng dẫn thể thức thi offline -->
                    <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-3 rounded-3" role="status" invisible="status == 'locked'">
                        <div>
                            <h6 class="fw-bold mb-1 text-primary"><i class="fa fa-file-excel-o me-1"/> Thể Thức Thi Offline (Làm Bài Ngoài Đời Thực / Chấm Bằng Excel):</h6>
                            <p class="mb-0 small text-muted">Học sinh làm bài trực tiếp trên giấy. Kết quả bài làm được giáo viên ghi vào file Excel và tải lên hệ thống để tự động chấm điểm và kích hoạt phân tích Claude AI.</p>
                        </div>
                        <div class="ms-3">
                            <button name="action_download_offline_template" 
                                    string="📄 Tải Phiếu Nhập Bài Làm Excel" 
                                    type="object" 
                                    class="btn btn-outline-primary btn-sm fw-bold"/>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Tên Đợt Kiểm Tra"/>
                        <h1><field name="name" placeholder="Ví dụ: Kiểm Tra Giữa Kỳ I - Lớp 3A1" readonly="status == 'locked'"/></h1>
                    </div>
                    <group>
                        <group string="Thông Tin Đợt Kiểm Tra">
                            <field name="code" placeholder="GK-3A1-202610" readonly="status == 'locked'"/>
                            <field name="class_id" readonly="status == 'locked'"/>
                            <field name="grade_id"/>
                            <field name="batch_type" readonly="status == 'locked'"/>
                            <field name="exam_id" domain="[('status', '=', 'active')]" readonly="status == 'locked'"/>
                            <field name="parent_batch_id" invisible="not parent_batch_id" readonly="1"/>
                        </group>
                        <group string="Thời Gian &amp; Hạn Chót Khóa Đợt">
                            <field name="start_datetime" readonly="status == 'locked'"/>
                            <field name="end_datetime" readonly="status == 'locked'"/>
                            <field name="is_expired" widget="boolean_toggle" readonly="1"/>
                            <field name="delivery_mode" readonly="1"/>
                        </group>
                    </group>
                    <group string="Thống Kê Kết Quả Thi">
                        <group>
                            <field name="total_students"/>
                            <field name="graded_count"/>
                            <field name="average_score"/>
                        </group>
                        <group>
                            <field name="passed_count" decoration-success="passed_count &gt; 0"/>
                            <field name="failed_count" decoration-danger="failed_count &gt; 0"/>
                            <field name="pass_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh Sách Bài Thi Của Học Sinh">
                            <field name="session_ids" readonly="status in ('completed', 'locked')">
                                <list>
                                    <field name="student_code" string="Mã Sinh Viên / Mã HS"/>
                                    <field name="student_name" string="Họ Và Tên Học Sinh"/>
                                    <field name="total_score" string="Điểm Đạt" decoration-success="total_score &gt;= 5.0" decoration-danger="total_score &lt; 5.0"/>
                                    <field name="correct_count" string="Số Đúng"/>
                                    <field name="wrong_count" string="Số Sai"/>
                                    <field name="percentage" widget="progressbar" string="Tỷ Lệ (%)"/>
                                    <field name="result_display" string="Kết Quả" widget="badge" decoration-success="passed == True" decoration-danger="passed == False and status == 'Graded'" decoration-muted="status != 'Graded'"/>
                                    <field name="status" widget="badge" decoration-info="status == 'NotStarted'" decoration-success="status == 'Graded'"/>
                                    <button name="action_view_session_detail" string="Xem Chi Tiết" type="object" icon="fa-eye" class="btn-sm btn-outline-primary" title="Bấm vào để xem output chi tiết bài làm"/>
                                </list>
                            </field>
                        </page>
                        <page string="Các Đợt Thi Lại Phát Sinh" invisible="not retest_batch_ids">
                            <field name="retest_batch_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="total_students"/>
                                    <field name="passed_count"/>
                                    <field name="failed_count"/>
                                    <field name="pass_rate" widget="progressbar"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi Chú &amp; Hướng Dẫn">
                            <field name="note" placeholder="Nhập ghi chú cho đợt thi này..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_batch_search" model="ir.ui.view">
        <field name="name">exam.batch.search</field>
        <field name="model">exam.batch</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Đợt Kiểm Tra">
                <field name="name"/>
                <field name="code"/>
                <field name="class_id"/>
                <field name="exam_id"/>
                <filter string="Đang Diễn Ra" name="filter_in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Đã Hoàn Thành" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Đã Khóa / Hết Hạn" name="filter_locked" domain="[('status', '=', 'locked')]"/>
                <filter string="Chưa Khóa" name="filter_unlocked" domain="[('status', '!=', 'locked')]"/>
                <filter string="Đợt Thi Lại" name="filter_retest" domain="[('batch_type', '=', 'retest')]"/>
                <group>
                    <filter string="Lớp Học" name="group_class" domain="[]" context="{'group_by': 'class_id'}"/>
                    <filter string="Loại Đợt" name="group_type" domain="[]" context="{'group_by': 'batch_type'}"/>
                    <filter string="Đề Thi" name="group_exam" domain="[]" context="{'group_by': 'exam_id'}"/>
                    <filter string="Trạng Thái" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_exam_batch" model="ir.actions.act_window">
        <field name="name">Đợt Kiểm Tra Lớp Học</field>
        <field name="res_model">exam.batch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_exam_batch_search"/>
    </record>

    <!-- ==================== 3. LƯỢT LÀM BÀI (exam.session) ==================== -->
    <record id="view_exam_session_list" model="ir.ui.view">
        <field name="name">exam.session.list</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Lượt Làm Bài">
                <field name="name"/>
                <field name="student_code" string="Mã HS"/>
                <field name="student_name" string="Học Sinh"/>
                <field name="batch_id" string="Đợt Kiểm Tra"/>
                <field name="exam_id" string="Đề Thi"/>
                <field name="class_id" string="Lớp Học"/>
                <field name="total_score" widget="float" string="Điểm" decoration-success="total_score &gt;= 5.0" decoration-danger="total_score &lt; 5.0"/>
                <field name="total_possible" widget="float"/>
                <field name="percentage" widget="progressbar"/>
                <field name="correct_count" string="Đúng"/>
                <field name="wrong_count" string="Sai"/>
                <field name="result_display" widget="badge" string="Kết Quả" decoration-success="passed == True" decoration-danger="passed == False and status == 'Graded'" decoration-muted="status != 'Graded'"/>
                <field name="end_time" string="Thời Gian Chấm"/>
                <field name="status" widget="badge" decoration-info="status == 'NotStarted'" decoration-success="status == 'Graded'"/>
                <button name="action_view_session_detail" string="Xem Chi Tiết" type="object" icon="fa-eye" class="btn-sm btn-outline-primary" title="Bấm vào để xem output chi tiết bài làm"/>
            </list>
        </field>
    </record>

    <record id="view_exam_session_form" model="ir.ui.view">
        <field name="name">exam.session.form</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <form string="Lượt Làm Bài Của Học Sinh">
                <header>
                    <button name="action_submit_exam" 
                            string="Chấm Điểm &amp; Phân Tích AI" 
                            type="object" 
                            class="oe_highlight btn-primary" 
                            groups="educational_system.group_school_teacher,educational_system.group_school_manager" 
                            invisible="status == 'Graded'"/>
                    <button name="action_submit_exam" 
                            string="Chấm Lại &amp; Phân Tích Lại" 
                            type="object" 
                            class="btn-secondary" 
                            groups="educational_system.group_school_teacher,educational_system.group_school_manager" 
                            invisible="status != 'Graded'"/>
                    <field name="status" widget="statusbar" statusbar_visible="NotStarted,Graded"/>
                </header>
                <sheet>
                    <!-- Banner khi chưa có điểm -->
                    <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-3 rounded-3" role="status" invisible="status == 'Graded'">
                        <div>
                            <i class="fa fa-info-circle fa-2x me-2 align-middle text-primary"/>
                            <span class="fs-5 align-middle">Phiên thi ngoại tuyến (Offline). Điểm số và chi tiết bài làm sẽ được cập nhật tự động khi giáo viên import kết quả từ tệp Excel của đợt kiểm tra.</span>
                        </div>
                    </div>

                    <!-- Banner khi đã chấm điểm -->
                    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-3 rounded-3" role="status" invisible="status != 'Graded'">
                        <div>
                            <i class="fa fa-check-circle fa-2x me-2 align-middle text-success"/>
                            <span class="fs-5 align-middle fw-semibold">Bài thi đã được chấm điểm! Điểm số: <strong><field name="total_score" readonly="1"/> / <field name="total_possible" readonly="1"/> (<field name="percentage" readonly="1"/>%)</strong> - Đánh giá: <strong><field name="result_display" readonly="1"/></strong></span>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Mã Phiên Thi"/>
                        <h1><field name="name" readonly="1" placeholder="Tự động sinh khi chọn học sinh và đề thi..."/></h1>
                    </div>
                    <group>
                        <group string="Thông Tin Học Sinh &amp; Đề Thi">
                            <field name="batch_id" readonly="1"/>
                            <field name="student_id" readonly="1"/>
                            <field name="student_code" readonly="1"/>
                            <field name="exam_id" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="auto_analyze"/>
                        </group>
                        <group string="Kết Quả Bài Làm">
                            <field name="total_possible" readonly="1"/>
                            <field name="total_score" readonly="1" invisible="status != 'Graded'"/>
                            <field name="percentage" widget="progressbar" invisible="status != 'Graded'"/>
                            <field name="correct_count" readonly="1" invisible="status != 'Graded'"/>
                            <field name="wrong_count" readonly="1" invisible="status != 'Graded'"/>
                            <field name="result_display" widget="badge" readonly="1" invisible="status != 'Graded'" decoration-success="passed == True" decoration-danger="passed == False"/>
                            <field name="end_time" readonly="1" invisible="status != 'Graded'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bộ Câu Hỏi &amp; Bài Làm">
                            <field name="answer_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="question_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                                    <field name="question_content" string="Nội Dung Câu Hỏi" readonly="1"/>
                                    <field name="question_type" string="Dạng Câu" readonly="1"/>
                                    <field name="question_points" string="Thang Điểm" readonly="1"/>
                                    <field name="answer_given" string="Đáp Án Học Sinh (Từ Excel)" readonly="1"/>
                                    <field name="is_correct" widget="boolean_toggle" readonly="1" column_invisible="parent.status != 'Graded'"/>
                                    <field name="points_earned" string="Điểm Đạt" readonly="1" column_invisible="parent.status != 'Graded'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kết Quả Phân Tích AI" invisible="status != 'Graded'">
                            <field name="analysis_ids" readonly="1">
                                <list>
                                    <field name="analysis_date"/>
                                    <field name="ai_model_version"/>
                                    <field name="status" widget="badge" decoration-success="status == 'completed'" decoration-warning="status == 'pending'" decoration-danger="status == 'failed'"/>
                                    <field name="feedback"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_session_search" model="ir.ui.view">
        <field name="name">exam.session.search</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Lượt Thi">
                <field name="student_id"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <filter string="Đang Làm Bài" name="filter_in_progress" domain="[('status', '=', 'InProgress')]"/>
                <filter string="Đã Chấm Điểm" name="filter_graded" domain="[('status', '=', 'Graded')]"/>
                <group>
                    <filter string="Đề Thi" name="group_exam" domain="[]" context="{'group_by': 'exam_id'}"/>
                    <filter string="Lớp Học" name="group_class" domain="[]" context="{'group_by': 'class_id'}"/>
                    <filter string="Học Sinh" name="group_student" domain="[]" context="{'group_by': 'student_id'}"/>
                    <filter string="Trạng Thái" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_exam_session" model="ir.actions.act_window">
        <field name="name">Lượt Làm Bài</field>
        <field name="res_model">exam.session</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_exam_session_list"/>
        <field name="search_view_id" ref="view_exam_session_search"/>
    </record>

    <!-- ==================== 4. WIZARD GÁN ĐỀ THI (exam.assign.wizard) ==================== -->
    <record id="view_exam_assign_wizard_form" model="ir.ui.view">
        <field name="name">exam.assign.wizard.form</field>
        <field name="model">exam.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Gán Đề Thi Cho Học Sinh">
                <sheet>
                    <div class="oe_title">
                        <h2>Gán Đề Thi Cho Học Sinh / Lớp</h2>
                    </div>
                    <group>
                        <field name="exam_id" readonly="1" options="{'no_open': True}"/>
                        <field name="assign_type" widget="radio"/>
                        <field name="class_id" invisible="assign_type != 'class'" required="assign_type == 'class'" placeholder="Chọn lớp nhận đề thi..."/>
                        <field name="student_ids" widget="many2many_tags" invisible="assign_type != 'students'" required="assign_type == 'students'" placeholder="Chọn danh sách học sinh..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign_exam" string="Phát Đề Cho Học Sinh" type="object" class="oe_highlight"/>
                    <button string="Hủy Bỏ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==================== 5. WIZARD IMPORT BÀI LÀM THI OFF TỪ EXCEL ==================== -->
    <record id="view_exam_batch_offline_import_wizard_form" model="ir.ui.view">
        <field name="name">exam.batch.offline.import.wizard.form</field>
        <field name="model">exam.batch.offline.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Bài Làm Thi Offline Từ Excel">
                <sheet>
                    <field name="state" invisible="1"/>
                    <div invisible="state != 'draft'">
                        <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-3" role="status">
                            <div>
                                <h6 class="fw-bold mb-1 text-primary"><i class="fa fa-info-circle me-1"/> Quy Trình Nhập Bài Làm Thi Offline:</h6>
                                <ol class="mb-0 ps-3 small">
                                    <li>Mở đợt kiểm tra và bấm <strong>"📄 Tải Phiếu Nhập Bài Làm Excel"</strong> để nhận file mẫu đã điền sẵn danh sách học sinh và các cột câu hỏi.</li>
                                    <li>Nhập đáp án của từng học sinh vào các cột câu hỏi tương ứng.</li>
                                    <li>Tải file Excel đó lên biểu mẫu này và bấm <strong>"Bắt Đầu Chấm Điểm &amp; Phân Tích AI"</strong>.</li>
                                </ol>
                            </div>
                        </div>

                        <group>
                            <group string="Đợt Kiểm Tra &amp; Tệp Dữ Liệu">
                                <field name="batch_id" readonly="1" options="{'no_open': True}"/>
                                <field name="excel_file" filename="filename" widget="binary"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            <group string="Cấu Hình Chấm Điểm">
                                <field name="auto_analyze"/>
                            </group>
                        </group>
                    </div>

                    <div invisible="state != 'done'">
                        <field name="result_html" nolabel="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import_offline_results" 
                            string="🚀 Bắt Đầu Chấm Điểm &amp; Phân Tích AI" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'draft'"/>
                    <button name="action_reset" 
                            string="🔄 Tải Lên Tệp Khác" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="state != 'done'"/>
                    <button name="action_view_batch" 
                            string="📂 Xem Đợt Kiểm Tra" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'done'"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_exam_batch_offline_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Bài Làm Thi Offline</field>
        <field name="res_model">exam.batch.offline.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
