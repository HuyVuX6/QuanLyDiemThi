<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================== -->
    <!-- 0. BẢNG ĐIỀU KHIỂN DASHBOARD & TỔNG QUAN  -->
    <!-- ========================================== -->
    <record id="view_education_dashboard_form" model="ir.ui.view">
        <field name="name">education.dashboard.form</field>
        <field name="model">education.dashboard</field>
        <field name="arch" type="xml">
            <form string="Bảng Điều Khiển Học Tập" create="false" delete="false">
                <header>
                    <button name="action_view_exam_stats" string="📊 Xem Biểu Đồ Thống Kê Điểm Thi" type="object" class="btn btn-primary"/>
                    <button name="action_view_question_stats" string="📈 Phân Tích Ngân Hàng Câu Hỏi" type="object" class="btn btn-secondary"/>
                    <button name="action_view_sessions" string="📝 Danh Sách Bài Thi" type="object" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="total_students" widget="statinfo" string="Học Sinh"/>
                        </button>
                        <button name="action_view_classes" type="object" class="oe_stat_button" icon="fa-university">
                            <field name="total_classes" widget="statinfo" string="Lớp Học"/>
                        </button>
                        <button name="action_view_exams" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="total_exams" widget="statinfo" string="Đề Thi"/>
                        </button>
                        <button name="action_view_questions" type="object" class="oe_stat_button" icon="fa-question-circle">
                            <field name="total_questions" widget="statinfo" string="Câu Hỏi"/>
                        </button>
                        <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="total_sessions" widget="statinfo" string="Lượt Làm Bài"/>
                        </button>
                        <button name="action_view_ai" type="object" class="oe_stat_button" icon="fa-magic">
                            <field name="completed_ai" widget="statinfo" string="AI Đã Đánh Giá"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <separator string="🎯 Kết Quả &amp; Chất Lượng Thi Cử"/>
                    <group>
                        <group string="Điểm Số &amp; Tỷ Lệ Đạt">
                            <field name="submitted_sessions" readonly="1"/>
                            <field name="avg_score" widget="float" readonly="1"/>
                        </group>
                        <group string="Đánh Giá Phổ Điểm">
                            <field name="pass_rate" widget="progressbar" readonly="1"/>
                            <field name="excellent_rate" widget="progressbar" readonly="1"/>
                        </group>
                    </group>

                    <separator string="🏫 Quy Mô &amp; Phân Tích Thông Minh"/>
                    <group>
                        <group string="Thông Tin Trường Lớp">
                            <field name="active_students" readonly="1"/>
                            <field name="total_instructors" readonly="1"/>
                        </group>
                        <group string="Tích Hợp Trí Tuệ Nhân Tạo (Claude AI)">
                            <field name="total_ai" readonly="1"/>
                            <field name="completed_ai" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_education_dashboard" model="ir.actions.server">
        <field name="name">Tổng Quan Dashboard</field>
        <field name="model_id" ref="model_education_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <!-- ========================================== -->
    <!-- 1. TRƯỜNG & LỚP HỌC (Grade, Class, Instructor, Student) -->
    <!-- ========================================== -->
    <!-- Khối Lớp -->
    <record id="view_school_grade_list" model="ir.ui.view">
        <field name="name">school.grade.list</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Khối Lớp">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_school_grade_form" model="ir.ui.view">
        <field name="name">school.grade.form</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <form string="Khối Lớp">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Danh Sách Lớp Trực Thuộc">
                            <field name="class_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_grade" model="ir.actions.act_window">
        <field name="name">Khối Lớp</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Lớp Học -->
    <record id="view_school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Lớp Học">
                <field name="code"/>
                <field name="name"/>
                <field name="grade_id"/>
                <field name="teacher_id"/>
                <field name="current_students"/>
                <field name="max_students"/>
            </list>
        </field>
    </record>

    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Lớp Học">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="grade_id"/>
                        </group>
                        <group>
                            <field name="teacher_id"/>
                            <field name="current_students"/>
                            <field name="max_students"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh Sách Học Sinh">
                            <field name="student_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Lớp Học</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Giáo Viên -->
    <record id="view_school_instructor_list" model="ir.ui.view">
        <field name="name">school.instructor.list</field>
        <field name="model">school.instructor</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Giáo Viên">
                <field name="code"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_school_instructor_form" model="ir.ui.view">
        <field name="name">school.instructor.form</field>
        <field name="model">school.instructor</field>
        <field name="arch" type="xml">
            <form string="Giáo Viên">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="specialization"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_instructor" model="ir.actions.act_window">
        <field name="name">Giáo Viên</field>
        <field name="res_model">school.instructor</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Học Sinh -->
    <record id="view_school_student_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Học Sinh">
                <field name="code"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="gender"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Hồ Sơ Học Sinh">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="parent_phone"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Thống kê học sinh theo lớp & giới tính -->
    <record id="view_school_student_graph" model="ir.ui.view">
        <field name="name">school.student.graph</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <graph string="Thống Kê Học Sinh Theo Lớp" type="bar" sample="1">
                <field name="class_id"/>
            </graph>
        </field>
    </record>

    <record id="view_school_student_pivot" model="ir.ui.view">
        <field name="name">school.student.pivot</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <pivot string="Ma Trận Học Sinh Theo Lớp &amp; Trạng Thái" sample="1">
                <field name="class_id" type="row"/>
                <field name="gender" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Học Sinh">
                <field name="name"/>
                <field name="code"/>
                <field name="class_id"/>
                <filter string="Đang Học" name="filter_active" domain="[('status', '=', 'Active')]"/>
                <group>
                    <filter string="Lớp Học" name="group_by_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Giới Tính" name="group_by_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Trạng Thái" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Học Sinh</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_school_student_report" model="ir.actions.act_window">
        <field name="name">Thống Kê Học Sinh Theo Lớp</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_by_class': 1}</field>
        <field name="search_view_id" ref="view_school_student_search"/>
    </record>


    <!-- ========================================== -->
    <!-- 2. NGÂN HÀNG CÂU HỎI & ĐỀ THI              -->
    <!-- ========================================== -->
    <!-- Câu Hỏi -->
    <record id="view_exam_question_list" model="ir.ui.view">
        <field name="name">exam.question.list</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <list string="Ngân Hàng Câu Hỏi">
                <field name="code"/>
                <field name="content"/>
                <field name="topic"/>
                <field name="difficulty"/>
                <field name="points"/>
                <field name="correct_answer"/>
            </list>
        </field>
    </record>

    <record id="view_exam_question_form" model="ir.ui.view">
        <field name="name">exam.question.form</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <form string="Câu Hỏi Toán 3">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="topic"/>
                            <field name="difficulty"/>
                            <field name="points"/>
                        </group>
                        <group>
                            <field name="correct_answer"/>
                        </group>
                    </group>
                    <group string="Nội Dung Câu Hỏi">
                        <field name="content" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_question_graph" model="ir.ui.view">
        <field name="name">exam.question.graph</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <graph string="Thống Kê Câu Hỏi Theo Chủ Đề" type="pie" sample="1">
                <field name="topic"/>
            </graph>
        </field>
    </record>

    <record id="view_exam_question_pivot" model="ir.ui.view">
        <field name="name">exam.question.pivot</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <pivot string="Ma Trận Ngân Hàng Câu Hỏi Theo Chủ Đề &amp; Độ Khó" sample="1">
                <field name="topic" type="row"/>
                <field name="difficulty" type="col"/>
                <field name="points" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_exam_question_search" model="ir.ui.view">
        <field name="name">exam.question.search</field>
        <field name="model">exam.question</field>
        <field name="arch" type="xml">
            <search string="Tìm Câu Hỏi">
                <field name="code"/>
                <field name="content"/>
                <field name="topic"/>
                <field name="difficulty"/>
                <group>
                    <filter string="Chủ Đề Toán" name="group_by_topic" context="{'group_by': 'topic'}"/>
                    <filter string="Độ Khó" name="group_by_difficulty" context="{'group_by': 'difficulty'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_exam_question" model="ir.actions.act_window">
        <field name="name">Ngân Hàng Câu Hỏi</field>
        <field name="res_model">exam.question</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_exam_question_report" model="ir.actions.act_window">
        <field name="name">Thống Kê Ngân Hàng Câu Hỏi</field>
        <field name="res_model">exam.question</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_by_topic': 1}</field>
        <field name="search_view_id" ref="view_exam_question_search"/>
    </record>

    <!-- Đề Thi -->
    <record id="view_exam_exam_list" model="ir.ui.view">
        <field name="name">exam.exam.list</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Đề Thi">
                <field name="code"/>
                <field name="name"/>
                <field name="exam_type"/>
                <field name="total_score"/>
                <field name="time_limit_minutes"/>
            </list>
        </field>
    </record>

    <record id="view_exam_exam_form" model="ir.ui.view">
        <field name="name">exam.exam.form</field>
        <field name="model">exam.exam</field>
        <field name="arch" type="xml">
            <form string="Đề Thi">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="exam_type"/>
                            <field name="total_score"/>
                            <field name="time_limit_minutes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ngân Hàng Câu Hỏi">
                            <field name="question_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_exam_exam" model="ir.actions.act_window">
        <field name="name">Đề Thi Toán 3</field>
        <field name="res_model">exam.exam</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================== -->
    <!-- 3. PHIÊN LÀM BÀI & THỐNG KÊ KẾT QUẢ THI    -->
    <!-- ========================================== -->
    <record id="view_exam_session_list" model="ir.ui.view">
        <field name="name">exam.session.list</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Lượt Làm Bài">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="exam_id"/>
                <field name="total_score"/>
                <field name="total_possible"/>
                <field name="percentage" widget="progressbar"/>
                <field name="correct_count"/>
                <field name="status" widget="badge"/>
                <field name="start_time"/>
            </list>
        </field>
    </record>

    <record id="view_exam_session_form" model="ir.ui.view">
        <field name="name">exam.session.form</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <form string="Lượt Làm Bài">
                <header>
                    <button name="action_submit_exam" string="Nộp Bài &amp; Chấm Điểm" type="object" class="oe_highlight" invisible="status != 'InProgress'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="exam_id"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="total_score"/>
                            <field name="total_possible"/>
                            <field name="percentage"/>
                            <field name="correct_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi Tiết Bài Làm">
                            <field name="answer_ids">
                                <list editable="bottom">
                                    <field name="question_id"/>
                                    <field name="answer_given"/>
                                    <field name="is_correct"/>
                                    <field name="points_earned"/>
                                </list>
                            </field>
                        </page>
                        <page string="Phân Tích AI">
                            <field name="analysis_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Thống kê biểu đồ Cột & Đường cho Phiên Làm Bài -->
    <record id="view_exam_session_graph" model="ir.ui.view">
        <field name="name">exam.session.graph</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <graph string="Thống Kê Điểm Số Theo Lớp &amp; Đề Thi" type="bar" sample="1">
                <field name="class_id"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Thống kê Ma Trận Pivot cho Phiên Làm Bài -->
    <record id="view_exam_session_pivot" model="ir.ui.view">
        <field name="name">exam.session.pivot</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <pivot string="Ma Trận Phân Tích Điểm Thi" sample="1">
                <field name="class_id" type="row"/>
                <field name="student_id" type="row"/>
                <field name="exam_id" type="col"/>
                <field name="total_score" type="measure"/>
                <field name="percentage" type="measure"/>
                <field name="correct_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_exam_session_search" model="ir.ui.view">
        <field name="name">exam.session.search</field>
        <field name="model">exam.session</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Lượt Thi">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="exam_id"/>
                <filter string="Đã Nộp / Đã Chấm" name="filter_submitted" domain="[('status', 'in', ('Submitted', 'Graded'))]"/>
                <filter string="Đang Làm" name="filter_inprogress" domain="[('status', '=', 'InProgress')]"/>
                <separator/>
                <filter string="Giỏi (>= 80%)" name="filter_high" domain="[('percentage', '&gt;=', 80)]"/>
                <filter string="Đạt (>= 50%)" name="filter_passed" domain="[('percentage', '&gt;=', 50)]"/>
                <filter string="Cần Cố Gắng (&lt; 50%)" name="filter_failed" domain="[('percentage', '&lt;', 50)]"/>
                <group>
                    <filter string="Theo Lớp" name="group_by_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Theo Đề Thi" name="group_by_exam" context="{'group_by': 'exam_id'}"/>
                    <filter string="Theo Học Sinh" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Theo Trạng Thái" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Lượt Thi thông thường -->
    <record id="action_exam_session" model="ir.actions.act_window">
        <field name="name">Lượt Làm Bài</field>
        <field name="res_model">exam.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_exam_session_search"/>
    </record>

    <!-- Action Báo Cáo Thống Kê Điểm Thi (Mặc định mở Graph & Pivot) -->
    <record id="action_exam_session_report" model="ir.actions.act_window">
        <field name="name">Thống Kê Điểm Thi &amp; Bài Làm</field>
        <field name="res_model">exam.session</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_by_class': 1}</field>
        <field name="search_view_id" ref="view_exam_session_search"/>
    </record>


    <!-- ========================================== -->
    <!-- 4. PHÂN TÍCH AI                           -->
    <!-- ========================================== -->
    <record id="view_ai_analysis_list" model="ir.ui.view">
        <field name="name">ai.analysis.list</field>
        <field name="model">ai.analysis</field>
        <field name="arch" type="xml">
            <list string="Danh Sách Đánh Giá AI">
                <field name="name"/>
                <field name="student_id"/>
                <field name="session_id"/>
                <field name="status" widget="badge"/>
                <field name="analysis_date"/>
            </list>
        </field>
    </record>

    <record id="view_ai_analysis_form" model="ir.ui.view">
        <field name="name">ai.analysis.form</field>
        <field name="model">ai.analysis</field>
        <field name="arch" type="xml">
            <form string="Phân Tích AI">
                <header>
                    <button name="action_analyze_with_claude" string="Phân Tích Với Claude" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="session_id"/>
