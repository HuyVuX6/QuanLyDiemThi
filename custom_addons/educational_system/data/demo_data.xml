        <record id="demo_q1" model="exam.question">
            <field name="code">CH-T3-01</field>
            <field name="content">Tính: 345 + 218 = ?</field>
            <field name="topic">Addition</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">563</field>
            <field name="points">1.0</field>
            <field name="explanation">Đặt tính rồi tính: 5 + 8 = 13 viết 3 nhớ 1; 4 + 1 = 5 thêm 1 = 6; 3 + 2 = 5. Kết quả là 563.</field>
        </record>

        <record id="demo_q2" model="exam.question">
            <field name="code">CH-T3-02</field>
            <field name="content">Tính: 782 - 349 = ?</field>
            <field name="topic">Subtraction</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">433</field>
            <field name="points">1.0</field>
            <field name="explanation">2 không trừ được 9, mượn 1 chục: 12 - 9 = 3; 8 - 4 - 1 = 3; 7 - 3 = 4. Kết quả là 433.</field>
        </record>

        <record id="demo_q3" model="exam.question">
            <field name="code">CH-T3-03</field>
            <field name="content">Tính nhẩm: 6 x 8 = ?</field>
            <field name="topic">Multiplication</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">48</field>
            <field name="points">1.0</field>
            <field name="explanation">Theo bảng nhân 6: 6 x 8 = 48.</field>
        </record>

        <record id="demo_q4" model="exam.question">
            <field name="code">CH-T3-04</field>
            <field name="content">Tính: 72 : 9 = ?</field>
            <field name="topic">Division</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">8</field>
            <field name="points">1.0</field>
            <field name="explanation">Theo bảng chia 9: 72 : 9 = 8 vì 9 x 8 = 72.</field>
        </record>

        <record id="demo_q5" model="exam.question">
            <field name="code">CH-T3-05</field>
            <field name="content">Một hình chữ nhật có chiều dài 8cm, chiều rộng 5cm. Chu vi của hình chữ nhật đó là bao nhiêu xăng-ti-mét?</field>
            <field name="topic">Geometry</field>
            <field name="difficulty">Medium</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">26</field>
            <field name="acceptable_answers">26|26 cm|26cm</field>
            <field name="points">2.0</field>
            <field name="explanation">Chu vi hình chữ nhật = (Chiều dài + Chiều rộng) x 2 = (8 + 5) x 2 = 13 x 2 = 26 (cm).</field>
        </record>

        <record id="demo_q6" model="exam.question">
            <field name="code">CH-T3-06</field>
            <field name="content">Một hình vuông có cạnh dài 6cm. Diện tích của hình vuông đó là bao nhiêu xăng-ti-mét vuông?</field>
            <field name="topic">Geometry</field>
            <field name="difficulty">Medium</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">36</field>
            <field name="acceptable_answers">36|36 cm2|36cm2</field>
            <field name="points">2.0</field>
            <field name="explanation">Diện tích hình vuông = Cạnh x Cạnh = 6 x 6 = 36 (cm2).</field>
        </record>

        <record id="demo_q7" model="exam.question">
            <field name="code">CH-T3-07</field>
            <field name="content">Mẹ mua 5 hộp bánh, mỗi hộp có 6 cái bánh. Hỏi mẹ đã mua tất cả bao nhiêu cái bánh?</field>
            <field name="topic">WordProblem</field>
            <field name="difficulty">Medium</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">30</field>
            <field name="acceptable_answers">30|30 cái|30 cái bánh</field>
            <field name="points">1.0</field>
            <field name="explanation">Số bánh mẹ mua là: 6 x 5 = 30 (cái bánh).</field>
        </record>

        <record id="demo_q8" model="exam.question">
            <field name="code">CH-T3-08</field>
            <field name="content">Có 45 bông hoa cắm đều vào 5 lọ hoa. Hỏi mỗi lọ có bao nhiêu bông hoa?</field>
            <field name="topic">WordProblem</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">numeric</field>
            <field name="correct_answer">9</field>
            <field name="acceptable_answers">9|9 bông|9 bông hoa</field>
            <field name="points">1.0</field>
            <field name="explanation">Mỗi lọ có số bông hoa là: 45 : 5 = 9 (bông hoa).</field>
        </record>

