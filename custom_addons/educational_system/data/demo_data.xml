        <!-- ==================== 5. NGÂN HÀNG CÂU HỎI TRẮC NGHIỆM THEO KHỐI (KHOI_3) ==================== -->
        <record id="demo_q1" model="exam.question">
            <field name="code">CH-TN-01</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Kết quả của phép tính: 345 + 218 là bao nhiêu?</field>
            <field name="topic">Addition</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">553</field>
            <field name="option_b">563</field>
            <field name="option_c">573</field>
            <field name="option_d">562</field>
            <field name="correct_answer">B</field>
            <field name="points">1.0</field>
            <field name="explanation">Đặt tính: 345 + 218 = 563. Đáp án đúng là B.</field>
        </record>

        <record id="demo_q2" model="exam.question">
            <field name="code">CH-TN-02</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Kết quả của phép tính: 782 - 349 là bao nhiêu?</field>
            <field name="topic">Subtraction</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">433</field>
            <field name="option_b">443</field>
            <field name="option_c">431</field>
            <field name="option_d">423</field>
            <field name="correct_answer">A</field>
            <field name="points">1.0</field>
            <field name="explanation">Đặt tính: 782 - 349 = 433. Đáp án đúng là A.</field>
        </record>

        <record id="demo_q3" model="exam.question">
            <field name="code">CH-TN-03</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Tính nhẩm: 6 x 8 = ?</field>
            <field name="topic">Multiplication</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">42</field>
            <field name="option_b">46</field>
            <field name="option_c">48</field>
            <field name="option_d">54</field>
            <field name="correct_answer">C</field>
            <field name="points">1.0</field>
            <field name="explanation">Theo bảng nhân 6: 6 x 8 = 48. Đáp án đúng là C.</field>
        </record>

        <record id="demo_q4" model="exam.question">
            <field name="code">CH-TN-04</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Tìm x, biết rằng: 72 : x = 9. Giá trị của x là:</field>
            <field name="topic">Division</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">7</field>
            <field name="option_b">8</field>
            <field name="option_c">9</field>
            <field name="option_d">6</field>
            <field name="correct_answer">B</field>
            <field name="points">1.0</field>
            <field name="explanation">x = 72 : 9 = 8 (vì 9 x 8 = 72). Đáp án đúng là B.</field>
        </record>

        <record id="demo_q5" model="exam.question">
            <field name="code">CH-TN-05</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Một hình chữ nhật có chiều dài 8 cm, chiều rộng 5 cm. Chu vi của hình chữ nhật đó là:</field>
            <field name="topic">Geometry</field>
            <field name="difficulty">Medium</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">13 cm</field>
            <field name="option_b">26 cm</field>
            <field name="option_c">40 cm</field>
            <field name="option_d">52 cm</field>
            <field name="correct_answer">B</field>
            <field name="points">1.0</field>
            <field name="explanation">Chu vi hình chữ nhật = (8 + 5) x 2 = 26 (cm). Đáp án đúng là B.</field>
        </record>

        <record id="demo_q6" model="exam.question">
            <field name="code">CH-TN-06</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Một hình vuông có cạnh dài 6 cm. Diện tích của hình vuông đó là:</field>
            <field name="topic">Geometry</field>
            <field name="difficulty">Medium</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">24 cm²</field>
            <field name="option_b">36 cm²</field>
            <field name="option_c">12 cm²</field>
            <field name="option_d">30 cm²</field>
            <field name="correct_answer">B</field>
            <field name="points">1.0</field>
            <field name="explanation">Diện tích hình vuông = 6 x 6 = 36 (cm²). Đáp án đúng là B.</field>
        </record>

        <record id="demo_q7" model="exam.question">
            <field name="code">CH-TN-07</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Mẹ mua 5 hộp bánh, mỗi hộp có 6 cái bánh. Hỏi mẹ đã mua tất cả bao nhiêu cái bánh?</field>
            <field name="topic">WordProblem</field>
            <field name="difficulty">Medium</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">11 cái</field>
            <field name="option_b">25 cái</field>
            <field name="option_c">30 cái</field>
            <field name="option_d">35 cái</field>
            <field name="correct_answer">C</field>
            <field name="points">1.0</field>
            <field name="explanation">Số bánh mẹ mua = 6 x 5 = 30 (cái). Đáp án đúng là C.</field>
        </record>

        <record id="demo_q8" model="exam.question">
            <field name="code">CH-TN-08</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Có 45 bông hoa cắm đều vào 5 lọ hoa. Hỏi mỗi lọ có bao nhiêu bông hoa?</field>
            <field name="topic">WordProblem</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">7 bông hoa</field>
            <field name="option_b">8 bông hoa</field>
            <field name="option_c">9 bông hoa</field>
            <field name="option_d">10 bông hoa</field>
            <field name="correct_answer">C</field>
            <field name="points">1.0</field>
            <field name="explanation">Mỗi lọ có số bông hoa = 45 : 5 = 9 (bông). Đáp án đúng là C.</field>
        </record>

        <record id="demo_q9" model="exam.question">
            <field name="code">CH-TN-09</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Một cuộn dây dài 7 m. Hỏi 8 cuộn dây như thế dài bao nhiêu mét?</field>
            <field name="topic">Multiplication</field>
            <field name="difficulty">Easy</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">56 m</field>
            <field name="option_b">54 m</field>
            <field name="option_c">49 m</field>
            <field name="option_d">63 m</field>
            <field name="correct_answer">A</field>
            <field name="points">1.0</field>
            <field name="explanation">8 cuộn dây dài = 7 x 8 = 56 (m). Đáp án đúng là A.</field>
        </record>

        <record id="demo_q10" model="exam.question">
            <field name="code">CH-TN-10</field>
            <field name="grade_id" ref="demo_grade_3"/>
            <field name="content">Thực hiện phép chia: 35 : 4. Thương và số dư lần lượt là:</field>
            <field name="topic">Division</field>
            <field name="difficulty">Hard</field>
            <field name="question_type">single_choice</field>
            <field name="option_a">Thương là 8, dư 3</field>
            <field name="option_b">Thương là 8, dư 2</field>
            <field name="option_c">Thương là 7, dư 7</field>
            <field name="option_d">Thương là 9, dư 1</field>
            <field name="correct_answer">A</field>
            <field name="points">1.0</field>
            <field name="explanation">35 : 4 = 8 (dư 3) vì 4 x 8 = 32, 35 - 32 = 3. Đáp án đúng là A.</field>
        </record>

