<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_ai_analysis" model="ir.cron">
            <field name="name">AI Analysis: Tự Động Phân Tích Bài Thi Pending</field>
            <field name="model_id" ref="model_ai_analysis"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_pending_analysis()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_auto_submit_expired_exams" model="ir.cron">
            <field name="name">Educational System: Tự Động Nộp Đề Thi Hết Hạn</field>
            <field name="model_id" ref="model_exam_session"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_submit_expired_sessions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
